# Public frontend settings: never put credentials in VITE_* values.
VITE_BASE_PATH=/Subtccstack/
# Leave empty to use the local /api proxy in dev, or show no backend in production.
VITE_API_URL=

# Server-only configuration. Production requires DATABASE_URL and explicit CORS origins.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=
PGLITE_DATA_DIR=./.cache/data/dev
