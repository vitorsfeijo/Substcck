# Public frontend settings: never put credentials in VITE_* values.
VITE_BASE_PATH=/Substcck/
# Leave empty to use the local /api proxy in dev, or show no backend in production.
VITE_API_URL=

# Server-only configuration. Production requires DATABASE_URL and explicit CORS origins.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=
PGLITE_DATA_DIR=./.cache/data/dev

# Institutional access is disabled until a real provider is configured.
# development enables ONLY fixed local personas; it never accepts UFRGS passwords.
AUTH_MODE=disabled
FRONTEND_URL=http://127.0.0.1:5173/Substcck/
PUBLIC_API_URL=http://127.0.0.1:3001/api
SESSION_TTL_SECONDS=3600
# Required only with AUTH_MODE=oidc. Never use VITE_* for these values.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ROLE_CLAIM=role
OIDC_ENROLLMENT_CLAIM=enrollment
OIDC_DEPARTMENT_CLAIM=department
OIDC_LOGIN_CLAIM=preferred_username
