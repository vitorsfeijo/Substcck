{
  "name": "substcck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "check": "npm run lint && npm test && npm run search:evaluate && npm run db:verify && npm run build:api && npm run build && npm run check:pages && npm run test:e2e && npm run test:e2e:auth",
    "dev:web": "vite --config config/vite.config.ts --host 127.0.0.1",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && vite build --config config/vite.config.ts",
    "build:api": "tsc -p config/tsconfig.server.json",
    "start:api": "node --env-file-if-exists=.env .cache/build/api/server/index.js",
    "preview": "vite preview --config config/vite.config.ts --host 127.0.0.1",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p config/tsconfig.app.json && tsc -p config/tsconfig.server.json --noEmit && tsc -p config/tsconfig.tools.json",
    "test": "vitest run --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:e2e:auth": "node scripts/test-auth-ui.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env server/scripts/migrate.ts",
    "db:verify": "tsx --env-file-if-exists=.env server/scripts/verify.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/scripts/seed.ts",
    "files:prune": "tsx --env-file-if-exists=.env server/scripts/prune-attachments.ts",
    "search:reindex": "tsx --env-file-if-exists=.env server/scripts/reindex-search.ts",
    "search:evaluate": "tsx server/scripts/evaluate-search.ts",
    "check:pages": "node scripts/check-pages.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@electric-sql/pglite": "0.5.12",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "10.1.6",
    "fastify": "5.12.7",
    "openid-client": "6.8.8",
    "pg": "^8.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "fflate": "0.8.3",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  }
}
