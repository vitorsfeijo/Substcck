{
  "name": "subtccstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "check": "npm run lint && npm test && npm run db:verify && npm run build:api && npm run build && npm run check:pages && npm run test:e2e",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node --env-file-if-exists=.env build/server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env server/scripts/migrate.ts",
    "db:verify": "tsx --env-file-if-exists=.env server/scripts/verify.ts",
    "check:pages": "node scripts/check-pages.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@fastify/cors": "^11.0.0",
    "fastify": "5.12.7",
    "pg": "^8.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  }
}
